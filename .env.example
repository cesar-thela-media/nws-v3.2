# Shadcn Space registry (local installs only; do not commit real keys)
SHADCNSPACE_EMAIL=
SHADCNSPACE_LICENSE_KEY=
EMAIL=
LICENSE_KEY=

# --- n8n form webhooks (server-side via POST /api/submit) ---
# Prefer server env (not exposed to browser):
WEBHOOK_URL_CONTACT=
N8N_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_URL=
WEBHOOK_URL_SCHEDULE=
WEBHOOK_URL_NEWSLETTER=
# Optional client aliases (legacy / preview only):
NEXT_PUBLIC_N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK_URL=

# --- Sentry (optional; app runs without these) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Areas hero map / bg overrides ---
# Google Maps embed (Share → Embed a map, or default Richmond/Fort Bend)
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_AREAS_HERO_BG=
